[Unit]
Description=A6 Trader Phase 0 read-only collection pass
After=network-online.target postgresql.service sub2api-singbox-proxy-pool.service
Wants=network-online.target
Requires=sub2api-singbox-proxy-pool.service
OnSuccess=a6-trader-seller-channel-onboard.service

[Service]
Type=oneshot
User=a6trader
Group=a6trader
EnvironmentFile=/etc/a6-trader.env
ExecStartPre=/opt/a6-trader/current/venv/bin/a6api-auto trade-import-sessions --sessions-dir /var/lib/a6-trader/secrets/sessions --proxy-map-file /var/lib/a6-trader/secrets/proxy-map.json
ExecStart=/usr/bin/flock --exclusive /var/lib/a6-trader/network-scan.lock /opt/a6-trader/current/venv/bin/a6api-auto trade-collect-once --sessions-dir /var/lib/a6-trader/secrets/sessions --proxy-map-file /var/lib/a6-trader/secrets/proxy-map.json --max-workers 8
SuccessExitStatus=2
TimeoutStartSec=8min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/a6-trader
UMask=0077
