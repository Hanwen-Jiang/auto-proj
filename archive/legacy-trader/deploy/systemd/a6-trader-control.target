[Unit]
Description=A6 Trader production workload control
Documentation=file:/opt/a6-trader/current/docs/a6-trader-system-control.md
After=network-online.target postgresql.service redis-server.service sub2api-singbox-proxy-pool.service

# Long-running production request and management planes.
Wants=a6-trader-dashboard.service
Wants=a6-listing-refresh-panel.service
Wants=a6-trader-upstream-relay.service
Wants=sub2api-bluegreen-48767.service
Wants=sub2api-callback-candidate-48768.service
Wants=sub2api-paid-send-candidate-48769.service

# Production schedulers and event triggers. The corresponding workers are
# intentionally not wanted directly: timers, paths and OnSuccess edges start them.
Wants=a6-trader-observer.service
Wants=a6-trader-provider-auto-pool-refresh.path
Wants=a6-trader-provider-liquidity.path
Wants=a6-trader-provider-membership-repair.service
Wants=a6-trader-provider-membership-apply.path
Wants=a6-trader-provider-failure-repair.timer
Wants=a6-trader-provider-runtime-failure.service
Wants=a6-trader-provider-dispatch.timer
Wants=a6-trader-channel-growth.timer
Wants=a6-trader-collector.timer
Wants=a6-trader-merchant-recovery.timer
Wants=a6-trader-model-publication.timer
Wants=a6-trader-model-publication.path
Wants=a6-trader-provider-generation-cleanup.timer
Wants=a6-trader-market-history-cleanup.timer
Wants=a6-trader-seller-channel-onboard.timer
Wants=a6-trader-seller-pilot.timer
Wants=a6-trader-seller-retirement.timer
Wants=a6-trader-seller-upstream-guard.timer
Wants=a6-trader-session-refresh.timer
Wants=a6-trader-cashout.timer
Wants=a6-trader-cashout-reconcile.timer
Wants=a6-trader-cashout-accounts.timer
Wants=a6-trader-economic-account-sync.timer
Wants=a6-trader-economic-priority1.timer
Wants=a6-trader-economic-priority1-listener.service

# Stop propagation covers every production trigger, every worker that may
# already be running, and every A6-specific request/management plane.
PropagatesStopTo=a6-trader-dashboard.service
PropagatesStopTo=a6-listing-refresh-panel.service
PropagatesStopTo=a6-trader-upstream-relay.service
PropagatesStopTo=sub2api-bluegreen-48767.service
PropagatesStopTo=sub2api-callback-candidate-48768.service
PropagatesStopTo=sub2api-paid-send-candidate-48769.service
PropagatesStopTo=a6-trader-observer.timer
PropagatesStopTo=a6-trader-observer.service
PropagatesStopTo=a6-trader-provider-auto-pool-refresh.path
PropagatesStopTo=a6-trader-provider-auto-pool.service
PropagatesStopTo=a6-trader-provider-liquidity.path
PropagatesStopTo=a6-trader-provider-membership-repair.service
PropagatesStopTo=a6-trader-provider-membership-apply.path
PropagatesStopTo=a6-trader-pin.timer
PropagatesStopTo=a6-trader-pin.path
PropagatesStopTo=a6-trader-pin.service
PropagatesStopTo=a6-trader-provider-pool-apply.timer
PropagatesStopTo=a6-trader-provider-pool-apply.service
PropagatesStopTo=a6-trader-provider-failure-repair.timer
PropagatesStopTo=a6-trader-provider-failure-repair.service
PropagatesStopTo=a6-trader-provider-runtime-failure.service
PropagatesStopTo=a6-trader-provider-dispatch.timer
PropagatesStopTo=a6-trader-provider-dispatch.service
PropagatesStopTo=a6-trader-channel-growth.timer
PropagatesStopTo=a6-trader-channel-growth.service
PropagatesStopTo=a6-trader-collector.timer
PropagatesStopTo=a6-trader-collector.service
PropagatesStopTo=a6-trader-merchant-recovery.timer
PropagatesStopTo=a6-trader-merchant-recovery.service
PropagatesStopTo=a6-trader-model-publication.timer
PropagatesStopTo=a6-trader-model-publication.path
PropagatesStopTo=a6-trader-model-publication.service
PropagatesStopTo=a6-trader-provider-generation-cleanup.timer
PropagatesStopTo=a6-trader-provider-generation-cleanup.service
PropagatesStopTo=a6-trader-market-history-cleanup.timer
PropagatesStopTo=a6-trader-market-history-cleanup.service
PropagatesStopTo=a6-trader-seller-channel-onboard.timer
PropagatesStopTo=a6-trader-seller-channel-onboard.service
PropagatesStopTo=a6-trader-seller-pilot.timer
PropagatesStopTo=a6-trader-seller-pilot.service
PropagatesStopTo=a6-trader-seller-retirement.timer
PropagatesStopTo=a6-trader-seller-retirement.service
PropagatesStopTo=a6-trader-seller-upstream-guard.timer
PropagatesStopTo=a6-trader-seller-upstream-guard.service
PropagatesStopTo=a6-trader-session-refresh.timer
PropagatesStopTo=a6-trader-session-refresh.service
PropagatesStopTo=a6-trader-cashout.timer
PropagatesStopTo=a6-trader-cashout.service
PropagatesStopTo=a6-trader-cashout-reconcile.timer
PropagatesStopTo=a6-trader-cashout-reconcile.service
PropagatesStopTo=a6-trader-cashout-accounts.timer
PropagatesStopTo=a6-trader-cashout-accounts.service
PropagatesStopTo=a6-trader-economic-account-sync.timer
PropagatesStopTo=a6-trader-economic-account-sync.service
PropagatesStopTo=a6-trader-economic-priority1.timer
PropagatesStopTo=a6-trader-economic-priority1.service
PropagatesStopTo=a6-trader-economic-priority1-listener.service

# Default-off and batch units are never started by this target. They are still
# part of the stop boundary so one stop command leaves no A6 background work.
PropagatesStopTo=a6-listing-refresh.service
PropagatesStopTo=a6-trader-provider-liquidity.timer
PropagatesStopTo=a6-trader-provider-liquidity.service
PropagatesStopTo=a6-trader-provider-pool-shadow.timer
PropagatesStopTo=a6-trader-provider-pool-shadow.service
PropagatesStopTo=a6-trader-focus-register-10.timer
PropagatesStopTo=a6-trader-focus-register-10.service
PropagatesStopTo=a6-trader-focus-register.service
PropagatesStopTo=a6-trader-slow-channel-registration.service
PropagatesStopTo=a6-trader-slow-register.service

[Install]
WantedBy=multi-user.target
