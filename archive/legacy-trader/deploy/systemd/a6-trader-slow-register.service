[Unit]
Description=A6 Trader slow merchant registration batch
After=network-online.target sub2api-singbox-proxy-pool.service
Wants=network-online.target
Requires=sub2api-singbox-proxy-pool.service

[Service]
Type=simple
User=a6trader
Group=a6trader
ExecStart=/opt/a6-trader/slow-register/current/venv/bin/a6api-auto batch --live --qq-file /var/lib/a6-trader/secrets/slow-register-qq.txt --state-dir /var/lib/a6-trader/secrets --batch-state /var/lib/a6-trader/secrets/batches/slow-register-20-v1.json --proxy-file /var/lib/a6-trader/secrets/slow-register-proxies.json --proxy-binding-map-file /var/lib/a6-trader/secrets/proxy-map.json --count 20 --min-interval-minutes 30 --max-interval-minutes 120 --per-account-retries 3 --enodot-admin-url https://ai.enodot.shop --enodot-admin-key-file /var/lib/a6-trader/secrets/enodot-admin-key.secret --enodot-group TPA6API
Restart=on-failure
RestartSec=60
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/a6-trader/secrets
UMask=0077

[Install]
WantedBy=multi-user.target
