[Unit]
Description=A6 Provider single-model plan-only shadow controller
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=a6trader
Group=a6trader
EnvironmentFile=/etc/a6-trader.env
# Default-off: PROVIDER_INVENTORY_RECONCILE_ENABLED must explicitly authorize
# canonical Provider/financial projection writes. Remote writes remain disabled.
ExecStart=/opt/a6-trader/current/venv/bin/python /opt/a6-trader/current/scripts/shadow_reconcile_a6_provider_pool.py --model gpt-5.6-sol --persist --observer-freshness-seconds 120 --inventory-freshness-seconds 900 --minimum-health-observers 2 --size-mode all_funded --initial-max-active-slots 12 --minimum-active-slots 4 --safe-concurrency-per-slot 1 --target-utilization 0.7 --minimum-pool-observation-days 14 --minimum-pool-shrink-interval-hours 72 --standby-count 0 --retry-reserve-multiplier 0.001 --realized-cost-window-hours 24 --realized-cost-match-tolerance-seconds 5 --minimum-cost-samples 100 --margin-bps 2000 --headroom-bps 0 --maximum-provider-cost-cny 0.3 --config-version a6-provider-topn-failover-v4-all-funded-dynamic-ready --transient-retry-attempts 3 --transient-retry-delay-seconds 3 --audit-log-file /var/lib/a6-trader/provider-pool-shadow-observations.jsonl
TimeoutStartSec=60s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/a6-trader
UMask=0077
