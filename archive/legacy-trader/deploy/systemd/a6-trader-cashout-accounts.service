[Unit]
Description=Reconcile A6 treasury wallet assignments and remote withdrawal accounts
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=a6trader
Group=a6trader
EnvironmentFile=/etc/a6-trader.env
ExecCondition=/bin/sh -c 'test "$TREASURY_CASHOUT_ENABLED" = "true"'
ExecStart=/usr/bin/flock --exclusive --nonblock --conflict-exit-code 75 /var/lib/a6-trader/treasury-cashout-accounts.lock /opt/a6-trader/current/venv/bin/python /opt/a6-trader/current/scripts/reconcile_a6_cashout.py --stage accounts --sync-wallet-inventory --activate-wallets --assign-wallets --inventory-confirmation a6-usdt-wallet-inventory-v1 --apply-wallet-accounts --account-max-workers 8 --account-max-creates 1000 --client-timeout-seconds 10 --compact-output
SuccessExitStatus=75
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/a6-trader
UMask=0077
