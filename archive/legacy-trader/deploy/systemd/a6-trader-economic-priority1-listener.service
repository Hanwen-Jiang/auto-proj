[Unit]
Description=Wake Priority 1 economic reconciliation after committed fact changes
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
PartOf=a6-trader-control.target

[Service]
Type=simple
User=a6trader
Group=a6trader
EnvironmentFile=/etc/a6-trader.env
ExecStart=/opt/a6-trader/current/venv/bin/python /opt/a6-trader/current/scripts/watch_a6_economic_facts.py --model gpt-5.6-sol --lock-file /var/lib/a6-trader/economic-priority1.lock --reconcile-timeout-seconds 12
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/a6-trader
UMask=0077

[Install]
WantedBy=a6-trader-control.target
