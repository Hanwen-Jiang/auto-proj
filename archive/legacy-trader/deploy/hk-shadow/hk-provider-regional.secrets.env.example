# Install as a root-owned mode-0600 file outside the release tree.
# Passwords are restricted to URL-safe characters by the staging script.
A6_PROVIDER_VALKEY_RUNTIME_PASSWORD=RUNTIME_PASSWORD_32_CHARS_MINIMUM
A6_PROVIDER_VALKEY_PROJECTOR_PASSWORD=PROJECTOR_PASSWORD_32_CHARS_MINIMUM

# This role is created and granted by migration 0042 prerequisites. It is used
# only by the Sub2API regional subscriber, never by the request plane.
PROVIDER_SUBSCRIBER_DATABASE_HOST=127.0.0.1
PROVIDER_SUBSCRIBER_DATABASE_PORT=15432
PROVIDER_SUBSCRIBER_DATABASE_USER=a6_provider_subscriber
PROVIDER_SUBSCRIBER_DATABASE_PASSWORD=SUBSCRIBER_PASSWORD_32_CHARS_MINIMUM
PROVIDER_SUBSCRIBER_DATABASE_DBNAME=sub2api_codexmanager
PROVIDER_SUBSCRIBER_DATABASE_SSLMODE=disable

# Use the separate a6_provider_projector login. The HK projector reaches the
# canonical PostgreSQL through the existing loopback state tunnel.
PROVIDER_REGIONAL_PROJECTOR_DATABASE_DSN=postgresql://a6_provider_projector:PROJECTOR_DB_PASSWORD@127.0.0.1:15432/sub2api_codexmanager?sslmode=disable
