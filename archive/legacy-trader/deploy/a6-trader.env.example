# Store the deployed value in /etc/a6-trader.env with mode 0600.
A6_TRADE_DATABASE_DSN=postgresql:///sub2api_codexmanager?host=/var/run/postgresql
PROVIDER_AUTO_POOL_ENABLED=false
PROVIDER_LIQUIDITY_RECONCILE_ENABLED=false
ECONOMIC_PRIORITY1_RECONCILE_ENABLED=true
ECONOMIC_PRIORITY1_ENABLED=true
# plan_only=false + projection apply active make the request plane honor the
# per-channel K_CNY profit gate (minimum = source_k_cny * (1 + bps) * 1.2 A6 cut).
ECONOMIC_PLAN_ONLY=false
ECONOMIC_API_SOURCES_ENABLED=false
ECONOMIC_ACCOUNT_SOURCES_ENABLED=true
ECONOMIC_A6_GATEWAY_ENABLED=false
ECONOMIC_PROJECTION_APPLY_ENABLED=true
# Real operator profit target on cost; the gate multiplies by the 1.2 A6 gross
# factor, i.e. 6000 bps => effective 9200 bps (1.6 * 1.2 = 1.92).
ECONOMIC_MINIMUM_PROFIT_ON_COST_BPS=6000
ECONOMIC_QUOTA_SNAPSHOT_MAX_AGE_SECONDS=60
ECONOMIC_CHANNEL_REVENUE_MAX_AGE_SECONDS=30
ECONOMIC_HEALTH_MAX_AGE_SECONDS=30
ECONOMIC_RECOVERY_CONFIRMATION_COUNT=2
ECONOMIC_COST_QUANTUM=0.000001
ECONOMIC_CONFIG_VERSION=priority1-economic-v1
ECONOMIC_CHANNEL_REVENUE_RECONCILE_ENABLED=true
ECONOMIC_FX_CNY_PER_USD=7.2
ECONOMIC_REVENUE_WINDOW_SECONDS=900
ECONOMIC_ACCOUNT_SYNC_ENABLED=false
ECONOMIC_ACCOUNT_ENODOT_URL=https://ai.enodot.shop
ECONOMIC_ACCOUNT_MODEL=gpt-5.6-sol
ECONOMIC_ACCOUNT_NAME=gpt-plus
ECONOMIC_ACCOUNT_GROUP_ID=26
ECONOMIC_ACCOUNT_PROVISIONAL_TOTAL_A=100
ECONOMIC_ACCOUNT_MINIMUM_TOTAL_A=50
ECONOMIC_ACCOUNT_MAXIMUM_TOTAL_A=300
ECONOMIC_ACCOUNT_USAGE_WORKERS=4
TREASURY_CASHOUT_ENABLED=false
TREASURY_WALLET_ACCOUNT_APPLY_ENABLED=false
TREASURY_STANDARD_WITHDRAW_APPLY_ENABLED=false
TREASURY_CALLBACK_SWEEP_APPLY_ENABLED=false
