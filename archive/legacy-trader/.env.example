# Prefer a 0600 file in production:
# A6_UPSTREAM_API_KEY_FILE=/absolute/path/to/upstream-api-key.secret
A6_UPSTREAM_API_KEY=

# Enodot admin credential used to select an active key from TPA6API.
AI_ENODOT_SHOP_ADMIN_KEY=

# Optional runtime paths:
A6_QQ_FILE=/absolute/path/to/qq-addresses.txt
A6_STATE_DIR=~/.config/a6api-auto
